# Supabase (Settings -> API in your Supabase project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Free LLM — Google Gemini (get a free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the model (default: gemini-2.5-flash)
LLM_MODEL=
# Optional, paid — only needed if an agent is configured (via the panel's
# Agent Settings) to use Claude or OpenAI instead of the free Gemini default.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google service account for GSC + GA4 (paste the full JSON as one line)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Email notifications (free, via Gmail SMTP — needs a Gmail "App Password", not your normal password)
# Only used for critical/warning system alerts now — routine approvals happen
# in the admin panel only, no per-draft email/Slack.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Comma-separated list of who should receive notifications
NOTIFY_EMAILS=

# GitHub PAT used by Supabase Edge Functions (panel-api) to:
#  - trigger this repo's own on-demand agent workflows
#  - re-trigger the digitalaura-website repo's deploy workflow right after a
#    publish/edit is approved, so the new/changed page gets prerendered for
#    crawlers within minutes instead of waiting on the next unrelated deploy
# Set via: npx supabase secrets set GITHUB_TOKEN=... GITHUB_REPO=... (this repo)
# Falls back to GITHUB_TOKEN for the website repo too unless WEBSITE_GITHUB_TOKEN
# / WEBSITE_GITHUB_REPO are set separately as their own Supabase secrets.
GITHUB_TOKEN=
GITHUB_REPO=
